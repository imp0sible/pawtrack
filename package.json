{
  "name": "lostdogs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,rt -c green,cyan \"next dev\" \"npm:realtime\"",
    "realtime": "tsx watch src/realtime/server.ts",
    "start:realtime": "tsx src/realtime/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "create:developer": "tsx scripts/create-developer.ts",
    "turso:schema": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "test:achievements": "tsx prisma/achievements-test.ts",
    "db:reset": "prisma migrate reset --force && npm run seed"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tanstack/react-query": "^5.101.3",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "nanoid": "^6.0.0",
    "next": "^16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.9.0": true,
    "@prisma/engines@7.9.0": true,
    "@prisma/client@7.9.0": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
