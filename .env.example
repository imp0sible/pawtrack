# Copy to .env and fill in. NEVER commit real secrets (.env* is gitignored).

# SQLite database file (relative to project root).
DATABASE_URL="file:./prisma/dev.db"

# Session signing secret — REQUIRED in production. Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to start with a short (<32 char) or default value.
JWT_SECRET="change-me-to-a-long-random-string"
SESSION_COOKIE_NAME="ld_session"

# Telegram bot (from @BotFather). Leave blank to run without Telegram:
#  - Telegram login button is hidden
#  - the bot is disabled but the realtime server still runs
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Public URLs exposed to the browser. Use your real https origins in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Realtime worker. INTERNAL_API_SECRET guards the internal /emit bridge and is
# REQUIRED in production (the worker refuses to start without it). Use a strong
# random value, different from JWT_SECRET.
REALTIME_PORT="3001"
INTERNAL_API_SECRET="change-me-to-a-long-random-string"

# Alpha window: accounts created on or before this date earn the "Alpha Pioneer"
# badge (forever). Accounts created after it never can. Extend/close the alpha by
# changing this. Optional — defaults to 2026-10-31 if unset.
ALPHA_ENDS_AT="2026-10-31T23:59:59Z"
